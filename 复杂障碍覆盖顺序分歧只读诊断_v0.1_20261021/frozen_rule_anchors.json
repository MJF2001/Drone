          {
            "line": 25,
            "text": "def reward_options(current,previous,pending,free,predator,weights):"
          },
          {
            "line": 26,
            "text": "    \"\"\"Pure scoring helper; neighbors are actual uncovered cardinal cells.\"\"\""
          },
          {
            "line": 27,
            "text": "    options=sorted(q for q in adjacent(current) if q in pending and q in free)"
          },
          {
            "line": 28,
            "text": "    if not options:return []"
          },
          {
            "line": 29,
            "text": "    ds={q:math.hypot(q[0]-predator[0],q[1]-predator[1]) for q in options}"
          },
          {
            "line": 30,
            "text": "    lo=min(ds.values());hi=max(ds.values());out=[]"
          },
          {
            "line": 31,
            "text": "    for q in options:"
          },
          {
            "line": 32,
            "text": "        rd=(ds[q]-lo)/(hi-lo) if hi>lo else 0.0"
          },
          {
            "line": 33,
            "text": "        if previous is None:rs=0.0"
          },
          {
            "line": 34,
            "text": "        else:"
          },
          {
            "line": 35,
            "text": "            old=(current[0]-previous[0],current[1]-previous[1])"
          },
          {
            "line": 36,
            "text": "            new=(q[0]-current[0],q[1]-current[1])"
          },
          {
            "line": 37,
            "text": "            rs=(old[0]*new[0]+old[1]*new[1]+1)/2"
          },
          {
            "line": 38,
            "text": "        n=sum(z in pending and z in free for z in adjacent(q))"
          },
          {
            "line": 39,
            "text": "        rb=(4-n)/4"
          },
          {
            "line": 40,
            "text": "        out.append(dict(cell=q,distance_reward=rd,straight_reward=rs,boundary_reward=rb,"
          },
          {
            "line": 41,
            "text": "                        score=rd+weights[0]*rs+weights[1]*rb))"
          },
          {
            "line": 42,
            "text": "    return out"
          },
          {
            "line": 43,
            "text": ""
          },
          {
            "line": 44,
            "text": ""
          },
          {
            "line": 45,
            "text": "def choose_neighbor(options):"
          },
          {
            "line": 46,
            "text": "    return min(options,key=lambda row:(-row['score'],row['cell']))['cell']"
          }
        ]
      }
