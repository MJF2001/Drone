+"""Six fixed handwritten synthetic snapshots. No planner/geometry imports."""
+from fractions import Fraction
+
+def r(x):
+    x = Fraction(x)
+    return {'n': x.numerator, 'd': x.denominator}
+def p(x, y):
+    return [r(x), r(y)]
+def expr(n, radical=None):
+    return {'terms': ([{'r': 1, 'c': r(n)}] if n else [])+
+            [{'r': k, 'c': r(v)} for k, v in (radical or {}).items()]}
+
